      VALUE "OriginalFilename", "TheRoyalCourt.exe"
      VALUE "ProductName", "The Royal Court | CK3 Mod Manager"
      VALUE "ProductVersion", "0.17.0"
    END
  END
  BLOCK "VarFileInfo"
